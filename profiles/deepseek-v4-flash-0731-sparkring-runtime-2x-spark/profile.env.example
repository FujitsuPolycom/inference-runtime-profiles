# Sanitized two-node profile. Copy to a private .env beside the launcher on
# each node and replace every placeholder. Never commit the populated file.

# Host paths
HOST_WORK_DIR=REPLACE_WITH_HOST_WORK_DIR
HOST_HF_CACHE_DIR=REPLACE_WITH_HOST_HUGGINGFACE_CACHE_DIR

# Container-internal path; use the image path unless the image layout differs.
CONTAINER_HF_HOME=REPLACE_WITH_CONTAINER_HUGGINGFACE_HOME

# Direct-link fabric addresses used by vLLM and the TP2 bootstrap.
RANK0_FABRIC_ADDR=REPLACE_WITH_RANK0_FABRIC_ADDRESS
RANK1_FABRIC_ADDR=REPLACE_WITH_RANK1_FABRIC_ADDRESS

# LAN addresses used by the two LMCache MP server URLs.
RANK0_LAN_ADDR=REPLACE_WITH_RANK0_LAN_ADDRESS
RANK1_LAN_ADDR=REPLACE_WITH_RANK1_LAN_ADDRESS

# MASTER_ADDR retained in the captured SparkRing container environment.
SPARKRING_MASTER_ADDR=REPLACE_WITH_SPARKRING_MASTER_ADDRESS

# SSH host or user-qualified target used by the rank 0 boot script.
RANK1_SSH_TARGET=REPLACE_WITH_RANK1_SSH_HOST_OR_ADDRESS
