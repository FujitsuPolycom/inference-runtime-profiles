# Sanitized four-node profile. Copy to a private .env on each node.
# Never commit the populated file.

IMAGE=REPLACE_WITH_ATTESTED_IMAGE_OR_DIGEST
EXPECTED_IMAGE_ID=REPLACE_WITH_ATTESTED_IMAGE_ID
MODEL_DIR=/srv/models/GLM-5.2-MXFP4-Experts-GPTQ
JIT_CACHE_DIR=/srv/cache/glm52-sparkring
CONTEXT_CACHE_DIR=/srv/cache/sparkcache
SPARKRING_SOURCE_DIR=/srv/sparkring/reference-source-bundle
SERVE_SCRIPT=/srv/sparkring/serve-glm52-trace.sh
LOAD_PREFLIGHT_SCRIPT=/srv/sparkring/glm52_load_format_preflight.py
SPARK_TRANSPORT_LIBRARY=/srv/sparkring/libspark_transport_capi.so
SPARKCACHE_NATIVE_LIBRARY=/srv/sparkring/libspark_cache_placement.so
SWITCHLESS_NCCL_LIBRARY=/srv/sparkring/libnccl-switchless.so.2

NODE_RANK=REPLACE_WITH_0_TO_3
HEAD_ADDR=REPLACE_WITH_HEAD_MANAGEMENT_ADDRESS
MASTER_PORT=29501
API_PORT=8210
MGMT_IFACE=REPLACE_WITH_MANAGEMENT_INTERFACE
NCCL_IB_HCA=REPLACE_WITH_COMMA_SEPARATED_ROCE_HCAS
NCCL_IB_GID_INDEX=3
SPARK_TP4_DEVICE0=REPLACE_WITH_FIRST_ROCE_DEVICE
SPARK_TP4_DEVICE1=REPLACE_WITH_SECOND_ROCE_DEVICE
SPARK_TP4_PEER0=REPLACE_WITH_DIRECT_NEIGHBOR_ADDRESS
SPARK_TP4_PEER1=REPLACE_WITH_DIRECT_NEIGHBOR_ADDRESS

SOURCE_BUNDLE_MANIFEST_SHA256=REPLACE_WITH_SOURCE_BUNDLE_MANIFEST_SHA256
SPARK_TRANSPORT_LIBRARY_SHA256=REPLACE_WITH_TRANSPORT_LIBRARY_SHA256
SPARKCACHE_NATIVE_LIBRARY_SHA256=REPLACE_WITH_SPARKCACHE_LIBRARY_SHA256
SWITCHLESS_NCCL_LIBRARY_SHA256=REPLACE_WITH_NCCL_LIBRARY_SHA256
Q2R_SESSION_ID=REPLACE_WITH_UNIQUE_ATTESTED_SESSION_ID
Q2R_CONFIG_SHA256=REPLACE_WITH_LAUNCH_CONFIG_SHA256
Q2R_RUNNER_SAMPLE_SHA256=REPLACE_WITH_RUNNER_SAMPLE_SHA256
