# GLM-5.2 EXL3 3.5-bpw fixed-MTP4, 4x DGX Spark. Values mirror
# recipes/glm52-exl3-r7-3.5bpw.json in the sparkring repository at commit
# 4545c4ec4740f203d4f427db265414a34bd8f5db; launch is owned by the sparkring
# launcher, not a compose file. Copy to a private .env per node; never commit
# the populated file.

SPARKRING_COMMIT=4545c4ec4740f203d4f427db265414a34bd8f5db
MODEL_ID=brandonmusic/GLM-5.2-EXL3-TR3v4-3.5bpw-MTP78
MODEL_REVISION=9ab9579774cc432df91567a36f6e9e863e0d4c9f
MODEL_DIR=REPLACE_WITH_MODEL_DIR

EXPECTED_IMAGE_ID=sha256:02881d5229d4f4d1cbba0cf40537492a2a505b9d4e43bbfe9a0b2a7bd0584513

NODE_RANK=REPLACE_WITH_0_TO_3
HEAD_MGMT_IP=REPLACE_WITH_HEAD_MANAGEMENT_ADDRESS
API_PORT=8210

# Ring fabric: one /24 per physical link, MTU 9000, RoCEv2 GID index 3.
# Each node uses both ConnectX-7 cages (f0 and f1).
RING_LINK0_SUBNET=REPLACE_WITH_LINK0_SUBNET
RING_LINK1_SUBNET=REPLACE_WITH_LINK1_SUBNET
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1

TP_SIZE=4
DCP_SIZE=4
MTP_POLICY=fixed-4
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.85
