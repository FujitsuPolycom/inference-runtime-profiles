# Candidate deployment: DeepSeek-V4-Flash-DSpark NVFP4 + CPU offload connector
# Copy to a private .env on each node and replace placeholders.
# Do NOT commit the private file.

# Same image as production Stage C
IMAGE_DIGEST=vllm-dspark-runtime:dspark-nvfp4-stage-c
MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-DSpark
SERVED_MODEL_NAME=DeepSeek-V4-Flash-NVFP4-CPUOffload-Candidate
HF_CACHE_DIR=/srv/cache/huggingface

# Node identity
NODE_RANK=REPLACE_WITH_0_OR_1
MASTER_ADDR=REPLACE_WITH_QSFP_HEAD_ADDRESS
MASTER_PORT=29518

# Isolated candidate port (different from Stage C's 18006)
PORT=18007

# Topology — identical to Stage C
TP=2
PP=1
MTP=3
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
MAX_CUDAGRAPH_CAPTURE_SIZE=32

# Slightly lower GPU utilization to make room for connector overhead
# Stage C uses 0.80; candidate uses 0.75 to avoid OOM during offload transfers
GPU_MEMORY_UTILIZATION=0.75
KV_CACHE_MEMORY_BYTES=10737418240

# CPU offload connector: 2 GiB per rank (4 GiB total across TP=2)
# This is the RAM-only L1 tier, synchronous, no NVMe
CPU_OFFLOAD_BYTES_PER_RANK=2147483648

# Network — same as Stage C
NCCL_IB_HCA=REPLACE_WITH_RDMA_INTERFACE
NCCL_SOCKET_IFNAME=REPLACE_WITH_SOCKET_INTERFACE
GLOO_SOCKET_IFNAME=REPLACE_WITH_SOCKET_INTERFACE
