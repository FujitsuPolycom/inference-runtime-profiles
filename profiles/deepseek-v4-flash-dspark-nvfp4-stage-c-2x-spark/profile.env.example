MODEL_ID=deepseek-ai/DeepSeek-V4-Flash-DSpark
SERVED_MODEL_NAME=DeepSeek-V4-Flash-NVFP4-StageC
HF_CACHE_DIR=/home/dooner/.cache/huggingface
DSPARK_PROPOSER_PATH=REPLACE_WITH_PATH_TO_dspark_proposer.py
NODE_RANK=REPLACE_WITH_0_OR_1
MASTER_ADDR=REPLACE_WITH_QSFP_HEAD_ADDRESS
MASTER_PORT=29517
PORT=18006
TP=2
PP=1
MTP=3
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
